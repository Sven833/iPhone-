# SQLite-Datenbankdatei (Standard reicht für lokale Nutzung / kleine Teams)
DATABASE_URL="file:./dev.db"

# Geheimer Schlüssel für NextAuth-Sessions, z.B. erzeugen mit: openssl rand -base64 32
AUTH_SECRET="bitte-mit-openssl-rand--base64-32-erzeugen"

# Zugangsdaten für den ersten Admin-Login (wird beim Ausführen von `npm run db:seed` angelegt)
ADMIN_EMAIL="info@msb-malerbetrieb.de"
ADMIN_PASSWORD="bitte-aendern"

# Geheimnis für den TradingView-Webhook, z.B. erzeugen mit: openssl rand -hex 16
# Muss im Alert-Payload als "secret" mitgeschickt werden.
TRADINGVIEW_WEBHOOK_SECRET="bitte-mit-openssl-rand--hex-16-erzeugen"

# Startkapital für das Paper-Trading-Konto (virtuell, in Euro)
PAPER_TRADING_STARTKAPITAL="10000"

# VAPID-Schlüsselpaar für Web-Push-Benachrichtigungen, erzeugen mit: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="bitte-mit-npx-web-push-generate-vapid-keys-erzeugen"
VAPID_PRIVATE_KEY="bitte-mit-npx-web-push-generate-vapid-keys-erzeugen"
