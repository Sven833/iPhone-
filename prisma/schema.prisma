// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Kunde {
  id        String    @id @default(cuid())
  name      String
  telefon   String?
  email     String?
  adresse   String?
  notizen   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  angebote  Angebot[]
}

model Angebot {
  id         Int               @id @default(autoincrement())
  titel      String
  status     String            @default("entwurf")
  notizen    String?
  kunde      Kunde             @relation(fields: [kundeId], references: [id])
  kundeId    String
  positionen AngebotPosition[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model AngebotPosition {
  id           String  @id @default(cuid())
  beschreibung String
  menge        Float
  einheit      String
  einzelpreis  Float
  reihenfolge  Int
  angebot      Angebot @relation(fields: [angebotId], references: [id], onDelete: Cascade)
  angebotId    Int
}
